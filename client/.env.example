# Backend base URL (no trailing slash). The web build must be served from an
# origin listed in the backend's CORS_ORIGINS.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth client ids (Google Cloud Console). Also add all three to the
# backend's GOOGLE_CLIENT_IDS. Leave empty to hide "Google ile devam et".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public links shown in the app.
EXPO_PUBLIC_PRIVACY_URL=https://example.com/gizlilik
EXPO_PUBLIC_TERMS_URL=https://example.com/kosullar

# Build-time only (read in app.config.ts, never shipped to the client).
APP_BUNDLE_ID=com.example.namazvakti
GOOGLE_MAPS_ANDROID_KEY=
EAS_PROJECT_ID=
