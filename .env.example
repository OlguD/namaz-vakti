# ---------------------------------------------------------------------------
# Namaz Vakti backend — copy to .env and fill in. Only the first block is required.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://vakit:vakit@localhost:5432/vakit
REDIS_URL=redis://localhost:6379/0
# 32+ random characters: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me

# --- HTTP -------------------------------------------------------------------
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true
# Set to true behind Traefik so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated; leave empty for native-app-only (no browser CORS).
CORS_ORIGINS=

# --- Auth ---------------------------------------------------------------------
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# Bundle id(s) / Services ID(s) that Apple identity tokens are issued for.
APPLE_CLIENT_IDS=com.example.namazvakti
# iOS, Android and web OAuth client ids from Google Cloud Console.
GOOGLE_CLIENT_IDS=
# Verified accounts with these e-mails become admin on sign-in (first-admin bootstrap).
ADMIN_EMAILS=

# --- E-mail (unset SMTP_HOST = messages are logged, not sent) -------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Namaz Vakti <no-reply@example.com>
# Links in e-mails open the app: <base>verify-email?token=…
APP_DEEP_LINK_BASE=namazvakti://

# --- Upstream data sources ---------------------------------------------------------
EMUSHAF_BASE_URL=https://ezanvakti.emushaf.net
# Identify yourself to free services (Nominatim/Overpass require it).
OUTBOUND_USER_AGENT=NamazVaktiBackend/0.1 (+https://example.com/contact)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# --- Live streams ---------------------------------------------------------------
# YouTube Data API v3 key (Google Cloud Console). Without it, live polling is off.
YOUTUBE_API_KEY=
LIVE_POLL_CRON=*/2 * * * *

# --- Push & moderation --------------------------------------------------------------
# Optional: only needed if "enhanced push security" is enabled on your Expo project.
EXPO_ACCESS_TOKEN=
# Optional: enables the AI moderation layer for chat (OpenAI moderation endpoint).
OPENAI_API_KEY=

# --- Worker ------------------------------------------------------------------------
WORKER_SCHEDULES_ENABLED=true
